# Скопируйте значения в .env. Настоящие секреты в репозиторий не попадают.
# Для разработки и размещения используйте РАЗНЫЕ BOT_TOKEN и WEBHOOK_SECRET.

# Токен бота от BotFather.
BOT_TOKEN=

# Строка подключения к PostgreSQL. scripts/pg-local.sh сам записывает её в .env.local
# (postgres://english_bot@127.0.0.1:54329/english_bot_dev), .env.local имеет приоритет над .env.
DATABASE_URL=

# polling — локально; webhook — на сервере. При NODE_ENV=production разрешён только webhook.
BOT_MODE=polling

# Порт и адрес HTTP-сервера. Адрес по умолчанию: 127.0.0.1 при polling, 0.0.0.0 при webhook.
# Railway задаёт PORT сам — не указывайте его в переменных сервиса.
PORT=3000
# HOST=

# Только для BOT_MODE=webhook.
# Публичный HTTPS-адрес сервиса без пути. Если не задан, берётся WEB_BASE_URL (на Railway это один сервис).
# Telegram будет присылать события на WEBHOOK_BASE_URL/telegram/webhook.
WEBHOOK_BASE_URL=
# Случайная строка не короче 32 символов: A-Z, a-z, 0-9, _ и -.
WEBHOOK_SECRET=

# Секрет для HMAC токенов ссылок, кодов и подписанных cookie, не короче 32 символов.
# Например: openssl rand -base64 48. Смена секрета делает недействительными выданные ссылки и коды.
APP_SECRET=

# production включает Secure у cookie и требует настоящий вход.
NODE_ENV=

# Публичный адрес кабинета без пути. По умолчанию http://localhost:PORT, в production обязателен https.
WEB_BASE_URL=

# Вход через Telegram: BotFather, раздел Login Widget. Адрес возврата: WEB_BASE_URL/api/auth/telegram/callback.
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=

# Только для разработки: вход под этим Telegram ID без Telegram. Роль не выдаёт.
# При NODE_ENV=production сервис с этой переменной не запустится.
DEV_LOGIN_TELEGRAM_ID=

# Папка сборки кабинета. По умолчанию dist/web.
# WEB_DIST_DIR=

# Необязательно: свой сервер Bot API вместо api.telegram.org.
# TELEGRAM_API_ROOT=

# Подробность журнала: fatal, error, warn, info (по умолчанию), debug, trace, silent.
# Журнал пишется в stdout строками JSON (поля level, message, time); Railway показывает их как структурированные логи.
# LOG_LEVEL=info

# ---------- Размещение на Railway (подробно: «Развёртывание и резервные копии.md») ----------
# Обязательные переменные сервиса: NODE_ENV=production, BOT_MODE=webhook, BOT_TOKEN (отдельный бот для пилота),
# WEBHOOK_SECRET, APP_SECRET, WEB_BASE_URL=https://<сервис>.up.railway.app, TELEGRAM_LOGIN_CLIENT_ID,
# TELEGRAM_LOGIN_CLIENT_SECRET, DATABASE_URL=${{Postgres.DATABASE_URL}} (ссылка на базу того же проекта).
# DEV_LOGIN_TELEGRAM_ID на сервере не задаётся: с ней сервис не запустится.

# Только для тестов. Имя базы обязано содержать "test": тесты очищают её целиком.
# По умолчанию postgres://english_bot@127.0.0.1:54329/english_bot_test
# TEST_DATABASE_URL=
